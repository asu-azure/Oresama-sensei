# Copy this file to `.env.local` (gitignored) and fill in real values.
# Restart `npm run dev` after editing.

# --- Supabase (browser) ---
# Project URL + publishable/anon key. Safe in the browser: RLS is the boundary.
# Either naming works (NEXT_PUBLIC_* is what the Vercel project already has).
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...

# --- Server only (src/pages/api/*) ---
# Ask Sensei, quick-add, kanji mnemonics, and embeddings.
GEMINI_API_KEY=...

# Optional: picture search for flashcards. Without it, search falls back to
# Openverse (no key). Free key: https://pixabay.com/api/docs/
PIXABAY_KEY=

# --- Not read by the app ---
# The Supabase MCP for Claude Code reads SUPABASE_ACCESS_TOKEN from your system
# environment (setx SUPABASE_ACCESS_TOKEN "<token>"), not from this file.
